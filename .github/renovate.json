{
  "extends": ["github>rancher/renovate-config//default#release"],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 2,
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "gomod"
  ],
  "packageRules": [
    {
      "matchBaseBranches": ["main"],
      "extends": ["github>rancher/renovate-config:rancher-main#release"]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/github.com/prometheus/*/"
      ]
    },
    {
      "description": "Pin Go minor on main to the Go version of the highest supported k8s (k8s 0.37 -> go 1.26); patch bumps still allowed",
      "matchDepNames": ["go", "golang"],
      "matchBaseBranches": ["main"],
      "allowedVersions": "<1.27"
    },
    {
      "description": "Group all GitHub Actions updates into a single PR per branch",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false
    },
    {
      "description": "Group golang.org/x/* packages into a single PR per branch",
      "matchPackageNames": [
        "/^golang\\.org\\/x\\//"
      ],
      "groupName": "golang.org/x packages"
    },
    {
      "description": "Activate automerge for eligible updates",
      "matchBaseBranches": [
        "main"
      ],
      "extends": ["github>rancher/renovate-config:automerge#release"]
    }
  ]
}
